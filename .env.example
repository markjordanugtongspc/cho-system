# =====================================================================
#  CHO Marawi Portal — Environment template
#  Copy this file to ".env" and fill in real values.
#  NEVER commit ".env" — it is listed in .gitignore.
# =====================================================================

# ---- Application ----------------------------------------------------
APP_NAME="CHO Marawi Portal"
APP_SHORT_NAME="CHO Marawi"
# local | staging | production
APP_ENV=local
# MUST be false in production (hides error details)
APP_DEBUG=true
APP_URL=http://cho-system.test
# Leave empty when served from the domain root (Laragon auto virtual host).
# Use "/CHO-System" if you open it as http://localhost/CHO-System
APP_BASE_PATH=
APP_TIMEZONE=Asia/Manila
# 64-char random hex. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_KEY=

# ---- Database (Laragon MySQL) ---------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cho_marawi
DB_USERNAME=root
DB_PASSWORD=

# ---- Session --------------------------------------------------------
SESSION_NAME=CHOSESSID
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
REMEMBER_DAYS=30

# ---- Rate limiting & lockout ----------------------------------------
# Max failed logins per username+IP inside the window (seconds)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900
# Max failed logins per IP (any username) inside the window
RATE_LIMIT_LOGIN_IP_MAX=20
# Global API requests per IP per window (seconds)
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_WINDOW=60
# Consecutive failures before the account is locked in the DB
ACCOUNT_LOCK_THRESHOLD=10
ACCOUNT_LOCK_MINUTES=30

# Comma-separated reverse-proxy IPs (leave empty on Laragon)
TRUSTED_PROXIES=

# ---- Vite dev server (NOT prefixed with VITE_ so it never reaches the browser bundle)
DEV_SERVER_HOST=localhost
DEV_SERVER_PORT=5175

# ---- First admin account (used once by: php database/install.php) ---
SEED_ADMIN_USERNAME=admin
# Remove this value after the install script has run!
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
